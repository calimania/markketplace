{
  "kind": "collectionType",
  "collectionName": "inboxes",
  "info": {
    "singularName": "inbox",
    "pluralName": "inboxes",
    "displayName": "Inbox",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string",
      "required": true
    },
    "Message": {
      "type": "text"
    },
    "email": {
      "type": "email",
      "required": true
    },
    "store": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::store.store"
    },
    "order": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::order.order",
      "inversedBy": "inbox_messages"
    },
    "Archived": {
      "type": "boolean"
    },
    "parentMessageId": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::inbox.inbox"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "Direction": {
      "type": "string",
      "default": "incoming"
    },
    "ThreadKey": {
      "type": "string"
    },
    "RoutingKey": {
      "type": "string"
    },
    "FromAddress": {
      "type": "email"
    },
    "ToAddress": {
      "type": "email"
    },
    "MessageId": {
      "type": "string"
    },
    "BodyHtml": {
      "type": "text"
    },
    "Metadata": {
      "type": "component",
      "repeatable": false,
      "component": "common.inbox-metadata"
    },
    "Estado": {
      "type": "string",
      "default": "new"
    }
  }
}
